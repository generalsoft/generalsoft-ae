---
// Google Analytics 4 loader.
//
// The measurement ID is public (it is visible in every page source), so it is
// safe to keep here. It only starts collecting once the visitor has accepted
// optional analytics in the cookie consent banner. Consent is stored by
// src/js/cookie-consent.js under the same localStorage key.
---
<script is:inline>
  (function () {
    var MEASUREMENT_ID = 'G-Q192G035DP';
    var CONSENT_KEY = 'generalsoft-cookie-consent';
    var loaded = false;

    function hasAnalyticsConsent() {
      try {
        var stored = localStorage.getItem(CONSENT_KEY);
        if (!stored) return false;
        var consent = JSON.parse(stored);
        return Boolean(consent && consent.analytics === true);
      } catch (error) {
        return false;
      }
    }

    function loadAnalytics() {
      if (loaded) return;
      loaded = true;

      window.dataLayer = window.dataLayer || [];
      window['gtag'] = function gtag() {
        window.dataLayer.push(arguments);
      };
      window['gtag']('js', new Date());
      window['gtag']('config', MEASUREMENT_ID);

      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(MEASUREMENT_ID);
      document.head.appendChild(script);
    }

    function disableAnalytics() {
      // Stops collection for the remainder of this page view after a withdrawal.
      window['ga-disable-' + MEASUREMENT_ID] = true;

      // Remove cookies GA may have set before consent was withdrawn.
      document.cookie.split(';').forEach(function (cookie) {
        var name = cookie.split('=')[0].trim();
        if (name === '_ga' || name.indexOf('_ga_') === 0) {
          document.cookie = name + '=; Max-Age=0; path=/;';
          document.cookie = name + '=; Max-Age=0; path=/; domain=' + location.hostname + ';';
          document.cookie = name + '=; Max-Age=0; path=/; domain=.' + location.hostname + ';';
        }
      });
    }

    document.addEventListener('cookie-consent-updated', function (event) {
      var consent = event.detail;
      if (consent && consent.analytics === true) {
        loadAnalytics();
      } else {
        disableAnalytics();
      }
    });

    if (hasAnalyticsConsent()) loadAnalytics();
  })();
</script>
